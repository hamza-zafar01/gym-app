# Copy to .env and fill in. Never commit .env.
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Include a database name, e.g. /fittrack
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fittrack?retryWrites=true&w=majority
# Port for the Express server (default 3001)
PORT=3001
# Frontend data source: "local" (localStorage) or "api" (this server). Default: local
VITE_DATA_SOURCE=local
